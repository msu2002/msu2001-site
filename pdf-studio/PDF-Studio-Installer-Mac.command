rm -f "$DESK_LINK"
ln -s "$APP" "$DESK_LINK"

# keep a copy of this installer to allow uninstalling
cp "$0" "$APP_DIR/Uninstall.command" 2>/dev/null; chmod +x "$APP_DIR/Uninstall.command" 2>/dev/null

if [ -z "$PDFWM_YES" ]; then
  dialog "تم التثبيت بنجاح ✔\nInstalled successfully.\n\nستجد البرنامج باسم «محرر PDF» في مجلد Applications وعلى سطح المكتب. يفتح في المتصفح ويعمل على جهازك فقط.\n\n$CREDIT" '"فتح البرنامج / Open"' "فتح البرنامج / Open"
  open "$APP"
fi
echo "INSTALL_OK"
