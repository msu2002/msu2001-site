#!/bin/bash
# =====================================================================
#  PDF Studio (محرر PDF) — Mac installer (double-click this file)
#  محرر PDF — أداة عربية متكاملة لتعديل ملفات PDF
#  قام بهذا العمل فهد بن عبدالله الجروان  |  Made by Fahad bin Abdullah Al-Jarwan
# =====================================================================
PREFIX="${PDFWM_PREFIX:-$HOME}"
APP_DIR="$PREFIX/Library/Application Support/PDFStudio"
APP_NAME="محرر PDF"
APP="$PREFIX/Applications/$APP_NAME.app"
DESK_LINK="$PREFIX/Desktop/$APP_NAME"
TITLE="محرر PDF — PDF Studio"
CREDIT="قام بهذا العمل فهد بن عبدالله الجروان"

dialog() { # text, buttons, default
  osascript -e "display dialog \"$1\" with title \"$TITLE\" buttons {$2} default button \"$3\" with icon note" >/dev/null 2>&1
}
alert() {
  osascript -e "display dialog \"$1\" with title \"$TITLE\" buttons {\"OK\"} default button \"OK\" with icon caution" >/dev/null 2>&1
}

if [ "$1" = "--uninstall" ]; then
  dialog "هل تريد إزالة البرنامج؟\nRemove $TITLE?" '"إلغاء","إزالة"' "إزالة" || exit 0
  rm -rf "$APP" "$APP_DIR"; [ -L "$DESK_LINK" ] && rm -f "$DESK_LINK"
  dialog "تمت الإزالة.\nUninstalled.\n\n$CREDIT" '"OK"' "OK"
  exit 0
fi

if [ -z "$PDFWM_YES" ]; then
  dialog "مرحبًا بك في محرر PDF\nأداة عربية: إزالة العلامة المائية، التوقيع، الدمج، التقسيم، التحويل إلى صور، تعديل النص\nWelcome to PDF Studio\n\nسيتم تثبيت البرنامج في مجلد Applications الخاص بك.\nThe app will be installed in your Applications folder.\n\n$CREDIT\nMade by Fahad bin Abdullah Al-Jarwan" '"إلغاء","تثبيت"' "تثبيت" || exit 0
fi

PY="$(command -v python3)"
if [ -z "$PY" ]; then
  alert "لم يتم العثور على Python 3.\nسيظهر الآن طلب تثبيت أدوات المطوّر من Apple؛ أكمل التثبيت ثم شغّل هذا الملف مرة أخرى.\n\nPython 3 was not found. Finish Apple's developer-tools install, then run this file again."
  xcode-select --install >/dev/null 2>&1
  exit 1
fi

mkdir -p "$APP_DIR" "$PREFIX/Applications"
echo "Creating environment… / جارٍ تجهيز البيئة…"
"$PY" -m venv "$APP_DIR/venv" || { alert "فشل إنشاء البيئة / venv creation failed"; exit 1; }
echo "Installing libraries… / جارٍ تثبيت المكتبات…"
VPY="$APP_DIR/venv/bin/python"
"$VPY" -m pip install --quiet --disable-pip-version-check --upgrade pip >/dev/null 2>&1
# Prefer ready-made wheels (no compiling). Newer releases may not exist for older/Intel Macs,
# so fall back to older versions automatically.
try_install() {
  for spec in "$@"; do
    if "$VPY" -m pip install --quiet --disable-pip-version-check --only-binary=:all: "$spec" >/dev/null 2>&1; then
      echo "  installed: $spec"; return 0
    fi
  done
  return 1
}
try_install pymupdf "pymupdf<2" "pymupdf<1.26.5" "pymupdf<1.25" "pymupdf<1.24" \
  || { alert "فشل تثبيت مكتبة PDF (تحقق من الاتصال بالإنترنت)\nCould not install the PDF library (check your internet connection)"; exit 1; }
try_install pikepdf "pikepdf<10" "pikepdf<9" "pikepdf<8" \
  || echo "  (pikepdf unavailable: layer/text-block removal will be limited)"
try_install numpy || { alert "فشل تثبيت numpy / numpy install failed"; exit 1; }
try_install pillow || { alert "فشل تثبيت Pillow / Pillow install failed"; exit 1; }

# --- the tool itself
cat > "$APP_DIR/pdf_studio.py" <<'PYEOF'
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
محرر PDF — PDF Studio
قام بهذا العمل فهد بن عبدالله الجروان
Made by Fahad bin Abdullah Al-Jarwan

برنامج محلي يعمل بدون إنترنت: تُعالَج الملفات على جهازك فقط.
Local, offline PDF toolkit: files never leave your computer.
"""
import base64
import io
import json
import mimetypes
import os
import re
import shutil
import socket
import sys
import tempfile
import threading
import time
import traceback
import types
import uuid
import webbrowser
import zipfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlparse

try:
    import pymupdf
except ImportError:  # older PyMuPDF
    import fitz as pymupdf

CREDIT_AR = "قام بهذا العمل فهد بن عبدالله الجروان"
CREDIT_EN = "Made by Fahad bin Abdullah Al-Jarwan"
APP_NAME = "محرر PDF"
VERSION = "1.0"

# ---- embedded pieces (filled in by build.py) ----
WM_B64 = ""
UI_B64 = ""


def _load_wm():
    if WM_B64.startswith("__"):
        here = os.path.dirname(os.path.abspath(__file__))
        src = open(os.path.join(here, "remove_pdf_watermark.py"), encoding="utf8").read()
    else:
        src = base64.b64decode(WM_B64).decode("utf8")
    mod = types.ModuleType("wm_engine")
    mod.__dict__["__name__"] = "wm_engine"
    exec(compile(src, "wm_engine", "exec"), mod.__dict__)
    return mod


def _load_ui():
    if UI_B64.startswith("__"):
        here = os.path.dirname(os.path.abspath(__file__))
        return open(os.path.join(here, "ui.html"), "rb").read()
    return base64.b64decode(UI_B64)


WM = _load_wm()
UI_HTML = _load_ui()

WORK = tempfile.mkdtemp(prefix="pdfstudio_")
FILES = {}          # id -> {"path","name","kind"}
LAST_PING = [0.0]
SEEN_PING = [False]
LOCK = threading.Lock()


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------
import unicodedata


def norm_ar(s):
    """Arabic presentation forms -> base letters, drop tashkeel/tatweel, lower-case."""
    s = unicodedata.normalize("NFKC", s or "")
    s = re.sub("[\u064B-\u065F\u0670\u0640]", "", s)
    return s.lower()


def norm_ar_keep(s):
    """Like norm_ar but keeps case and diacritics (for display/editing)."""
    return unicodedata.normalize("NFKC", s or "")


def safe_name(s):
    s = re.sub(r'[\\/:*?"<>|\x00-\x1f]', "_", s or "file").strip()
    return s or "file"


def new_path(name):
    d = os.path.join(WORK, uuid.uuid4().hex[:10])
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, safe_name(name))


def register(path, kind="pdf", name=None):
    fid = uuid.uuid4().hex[:12]
    with LOCK:
        FILES[fid] = {"path": path, "name": name or os.path.basename(path), "kind": kind}
    return fid


def get_file(fid):
    f = FILES.get(fid)
    if not f or not os.path.exists(f["path"]):
        raise ApiError("الملف غير موجود، أعد رفعه / file not found")
    return f


class ApiError(Exception):
    pass


def open_pdf(fid, password=None):
    f = get_file(fid)
    doc = pymupdf.open(f["path"])
    if doc.needs_pass:
        if not password or not doc.authenticate(password):
            raise ApiError("الملف محمي بكلمة مرور")
    return doc


def info_of(fid):
    f = get_file(fid)
    doc = pymupdf.open(f["path"])
    enc = doc.needs_pass
    pages = [] if enc else [[round(p.rect.width, 1), round(p.rect.height, 1)] for p in doc]
    out = {"id": fid, "name": f["name"], "pages": len(doc) if not enc else 0,
           "sizes": pages, "encrypted": bool(enc)}
    doc.close()
    return out


def parse_pages(spec, n):
    """'1-3,5,7-' -> [0,1,2,4,6..n-1]; empty = all"""
    spec = (spec or "").strip().replace("،", ",").replace("؛", ",")
    if not spec:
        return list(range(n))
    out = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        m = re.fullmatch(r"(\d*)\s*-\s*(\d*)", part)
        if m:
            a = int(m.group(1)) if m.group(1) else 1
            b = int(m.group(2)) if m.group(2) else n
            if a > b:
                a, b = b, a
            out.extend(range(max(a, 1) - 1, min(b, n)))
        elif part.isdigit():
            i = int(part)
            if 1 <= i <= n:
                out.append(i - 1)
        else:
            raise ApiError("صيغة الصفحات غير صحيحة: " + part)
    seen, res = set(), []
    for i in out:
        if i not in seen:
            seen.add(i)
            res.append(i)
    return res


def hex_to_rgb01(h, default=(0, 0, 0)):
    try:
        h = h.lstrip("#")
        if len(h) == 3:
            h = "".join(c * 2 for c in h)
        return tuple(int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4))
    except Exception:
        return default


def find_font():
    """A TTF with Arabic + Latin coverage from the system."""
    cands = [
        r"C:\Windows\Fonts\tahoma.ttf", r"C:\Windows\Fonts\arial.ttf", r"C:\Windows\Fonts\segoeui.ttf",
        "/System/Library/Fonts/Supplemental/Arial.ttf", "/Library/Fonts/Arial Unicode.ttf",
        "/System/Library/Fonts/Supplemental/Tahoma.ttf", "/System/Library/Fonts/Supplemental/Arial Unicode.ttf",
        "/usr/share/fonts/truetype/noto/NotoSansArabic-Regular.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/dejavu/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans.ttf",
    ]
    for c in cands:
        if os.path.exists(c):
            return c
    for root in ("/usr/share/fonts", "/Library/Fonts", "/System/Library/Fonts"):
        for dp, _, fs in os.walk(root):
            for f in fs:
                if f.lower() in ("notosansarabic-regular.ttf", "dejavusans.ttf", "arial.ttf"):
                    return os.path.join(dp, f)
    return None


FONT_PATH = find_font()


def font_archive():
    """Archive+css for insert_htmlbox so Arabic is shaped (RTL) and rendered."""
    if FONT_PATH:
        d = os.path.dirname(FONT_PATH)
        arch = pymupdf.Archive(d)
        css = '@font-face{font-family:"PSFont";src:url("%s");}' % os.path.basename(FONT_PATH)
        return arch, css, "PSFont"
    return None, "", "sans-serif"


def html_text(text, size, color, bold=False, italic=False, align="right", family="PSFont"):
    esc = (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
           .replace("\n", "<br>"))
    rgb = "#%02x%02x%02x" % tuple(int(c * 255) for c in color)
    st = "font-family:%s;font-size:%spt;color:%s;text-align:%s;direction:rtl;unicode-bidi:plaintext;" % (
        family, size, rgb, align)
    if bold:
        st += "font-weight:bold;"
    if italic:
        st += "font-style:italic;"
    return '<div style="%s">%s</div>' % (st, esc)


def put_text(page, rect, text, size=14, color=(0, 0, 0), bold=False, italic=False,
             align="right", opacity=1.0, rotate=0):
    arch, css, fam = font_archive()
    html = html_text(text, size, color, bold, italic, align, fam)
    page.insert_htmlbox(rect, html, css=css, archive=arch, opacity=opacity, rotate=rotate, scale_low=0.4)


def text_size_estimate(text, size):
    lines = text.split("\n")
    w = max(len(l) for l in lines) * size * 0.62 + 12
    h = len(lines) * size * 1.6 + 8
    return w, h


def render_text_png(text, size, color, bold, italic, opacity, angle):
    """Text -> transparent PNG (any rotation / opacity) using MuPDF shaping."""
    from PIL import Image
    w, h = text_size_estimate(text, size)
    w, h = max(w, 40), max(h, 24)
    d = pymupdf.open()
    pg = d.new_page(width=w, height=h)
    put_text(pg, pymupdf.Rect(2, 2, w - 2, h - 2), text, size, color, bold, italic, "center")
    pix = pg.get_pixmap(dpi=300, alpha=True)
    img = Image.frombytes("RGBA", (pix.width, pix.height), pix.samples)
    bbox = img.getbbox()
    if bbox:
        img = img.crop(bbox)
    if opacity < 1:
        al = img.getchannel("A").point(lambda v: int(v * opacity))
        img.putalpha(al)
    if angle:
        img = img.rotate(angle, expand=True, resample=Image.BICUBIC)
    b = io.BytesIO()
    img.save(b, "PNG")
    return b.getvalue(), img.size


# --------------------------------------------------------------------------
# operations
# --------------------------------------------------------------------------
def op_watermark(p):
    f = get_file(p["id"])
    out = new_path(os.path.splitext(f["name"])[0] + "_بدون_علامة.pdf")
    logs = []
    texts = [t for t in re.split(r"[;؛\n]", p.get("texts", "")) if t.strip()]
    WM.remove_watermarks(f["path"], out, texts, bool(p.get("stamps")), bool(p.get("allImages")),
                         bool(p.get("aggressive")), p.get("password") or None, auto=True,
                         log=logs.append, scan=bool(p.get("scan", True)))
    fid = register(out, "pdf")
    return {"id": fid, "name": os.path.basename(out), "log": logs}


def op_signature_clean(p):
    from PIL import Image
    import numpy as np
    raw = base64.b64decode(p["data"].split(",")[-1])
    img = Image.open(io.BytesIO(raw)).convert("RGB")
    if max(img.size) > 2400:
        img.thumbnail((2400, 2400))
    a = np.asarray(img).astype("float32")
    lum = a.mean(2)
    sens = float(p.get("sensitivity", 50)) / 100.0          # 0..1
    # estimate paper brightness from the border / bright percentile
    paper = float(np.percentile(lum, 90))
    hi = max(paper - 8, 60)                                  # >= hi : transparent
    lo = hi - (30 + 110 * (1 - sens))                        # <= lo : fully opaque
    alpha = np.clip((hi - lum) / max(hi - lo, 1), 0, 1)
    alpha = alpha ** 0.8
    tint = p.get("color")
    out = np.zeros(a.shape[:2] + (4,), dtype="uint8")
    if tint:
        r, g, b = [int(c * 255) for c in hex_to_rgb01(tint)]
        out[..., 0], out[..., 1], out[..., 2] = r, g, b
    else:
        # un-premultiply ink colour (darken a bit for crisp look)
        out[..., :3] = np.clip(a * 0.9, 0, 255).astype("uint8")
    out[..., 3] = (alpha * 255).astype("uint8")
    res = Image.fromarray(out, "RGBA")
    bbox = res.getchannel("A").point(lambda v: 255 if v > 20 else 0).getbbox()
    if bbox:
        res = res.crop(bbox)
    b = io.BytesIO()
    res.save(b, "PNG")
    return {"png": "data:image/png;base64," + base64.b64encode(b.getvalue()).decode(),
            "w": res.size[0], "h": res.size[1]}


def op_sign(p):
    f = get_file(p["id"])
    doc = open_pdf(p["id"], p.get("password"))
    png = base64.b64decode(p["png"].split(",")[-1])
    from PIL import Image
    im = Image.open(io.BytesIO(png))
    ratio = im.size[1] / im.size[0]
    n = len(doc)
    scope = p.get("scope", "current")
    if scope == "all":
        idx = list(range(n))
    elif scope == "last":
        idx = [n - 1]
    elif scope == "range":
        idx = parse_pages(p.get("range", ""), n)
    else:
        idx = [min(max(int(p.get("page", 0)), 0), n - 1)]
    angle = float(p.get("angle", 0) or 0)
    if angle:
        im = im.rotate(-angle, expand=True, resample=Image.BICUBIC)
        b = io.BytesIO()
        im.save(b, "PNG")
        png = b.getvalue()
        ratio = im.size[1] / im.size[0]
    for i in idx:
        pg = doc[i]
        W, H = pg.rect.width, pg.rect.height
        w = float(p["w"]) * W
        x = float(p["x"]) * W
        y = float(p["y"]) * H
        rect = pymupdf.Rect(x, y, x + w, y + w * ratio)
        pg.insert_image(rect, stream=png, keep_proportion=True, overlay=True)
    out = new_path(os.path.splitext(f["name"])[0] + "_موقّع.pdf")
    finalize(doc, out)
    return {"id": register(out), "name": os.path.basename(out), "pages": len(idx)}


def finalize(doc, out):
    meta = dict(doc.metadata or {})
    meta["producer"] = APP_NAME + " — " + CREDIT_AR
    try:
        doc.set_metadata(meta)
    except Exception:
        pass
    doc.save(out, garbage=3, deflate=True)
    doc.close()


def op_merge(p):
    items = p["items"]          # [{id, range}]
    if len(items) < 2:
        raise ApiError("اختر ملفين على الأقل")
    out_doc = pymupdf.open()
    toc = []
    for it in items:
        d = open_pdf(it["id"], it.get("password"))
        idx = parse_pages(it.get("range", ""), len(d))
        start = len(out_doc)
        for i in idx:
            out_doc.insert_pdf(d, from_page=i, to_page=i)
        if p.get("bookmarks", True) and idx:
            toc.append([1, os.path.splitext(get_file(it["id"])["name"])[0], start + 1])
        d.close()
    if toc:
        out_doc.set_toc(toc)
    out = new_path(safe_name(p.get("name") or "ملف_مدموج") .replace(".pdf", "") + ".pdf")
    finalize(out_doc, out)
    return {"id": register(out), "name": os.path.basename(out)}


def op_split(p):
    f = get_file(p["id"])
    doc = open_pdf(p["id"], p.get("password"))
    n = len(doc)
    mode = p.get("mode", "count")
    groups, names = [], []
    if mode == "count":
        k = max(int(p.get("count", 1) or 1), 1)
        groups = [list(range(i, min(i + k, n))) for i in range(0, n, k)]
    elif mode == "ranges":
        for part in re.split(r"[;؛\n]", (p.get("ranges") or "").replace(",", ";")):
            if part.strip():
                g = parse_pages(part, n)
                if g:
                    groups.append(g)
        if not groups:
            raise ApiError("أدخل نطاقات مثل: 1-3 ; 4-6")
    elif mode == "size":
        tol = float(p.get("tol", 2))
        cur, last = [], None
        for i, pg in enumerate(doc):
            sz = (round(pg.rect.width), round(pg.rect.height))
            if last is None or (abs(sz[0] - last[0]) <= tol and abs(sz[1] - last[1]) <= tol):
                cur.append(i)
            else:
                groups.append(cur)
                cur = [i]
            if last is None or sz != last:
                last = sz if (last is None or abs(sz[0] - last[0]) > tol or abs(sz[1] - last[1]) > tol) else last
        if cur:
            groups.append(cur)
    elif mode == "text":
        needle = (p.get("text") or "").strip()
        if not needle:
            raise ApiError("اكتب النص الذي يبدأ عنده كل ملف")
        nl = norm_ar(needle)
        starts = []
        for i, pg in enumerate(doc):
            t = norm_ar(pg.get_text())
            if nl in t or nl[::-1] in t:
                starts.append(i)
        if not starts:
            raise ApiError("لم أجد هذا النص في أي صفحة")
        if starts[0] != 0 and p.get("keepHead", True):
            starts = [0] + starts
        starts.append(n)
        for a, b in zip(starts, starts[1:]):
            groups.append(list(range(a, b)))
        if mode == "text":
            for g in groups:
                t = norm_ar(doc[g[0]].get_text()).strip().split("\n")
                names.append(" ".join(t[0].split())[:40] if t and t[0] else "")
    else:
        raise ApiError("وضع غير معروف")
    base = os.path.splitext(f["name"])[0]
    zpath = new_path(base + "_مقسّم.zip")
    with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED) as z:
        for gi, g in enumerate(groups, 1):
            nd = pymupdf.open()
            for i in g:
                nd.insert_pdf(doc, from_page=i, to_page=i)
            label = safe_name(names[gi - 1]) if names and names[gi - 1] else ""
            fn = "%s_%02d%s.pdf" % (base, gi, ("_" + label) if label else "")
            nd.set_metadata({"producer": APP_NAME + " — " + CREDIT_AR})
            z.writestr(fn, nd.tobytes(garbage=3, deflate=True))
            nd.close()
    doc.close()
    return {"id": register(zpath, "zip"), "name": os.path.basename(zpath), "parts": len(groups)}


def op_toimages(p):
    f = get_file(p["id"])
    doc = open_pdf(p["id"], p.get("password"))
    idx = parse_pages(p.get("range", ""), len(doc))
    fmt = "jpg" if p.get("format") == "jpg" else "png"
    dpi = int(p.get("dpi", 150))
    base = os.path.splitext(f["name"])[0]
    files = []
    for i in idx:
        pix = doc[i].get_pixmap(dpi=dpi, alpha=False)
        data = pix.tobytes("jpeg" if fmt == "jpg" else "png")
        files.append(("%s_صفحة_%03d.%s" % (base, i + 1, fmt), data))
    doc.close()
    if len(files) == 1:
        out = new_path(files[0][0])
        open(out, "wb").write(files[0][1])
        return {"id": register(out, fmt), "name": os.path.basename(out), "count": 1}
    zpath = new_path(base + "_صور.zip")
    with zipfile.ZipFile(zpath, "w", zipfile.ZIP_STORED) as z:
        for n, d in files:
            z.writestr(n, d)
    return {"id": register(zpath, "zip"), "name": os.path.basename(zpath), "count": len(files)}


def op_spans(q):
    doc = open_pdf(q["id"], q.get("password"))
    pg = doc[int(q.get("page", 0))]
    W, H = pg.rect.width, pg.rect.height
    out = []
    d = pg.get_text("dict")
    for b in d.get("blocks", []):
        for ln in b.get("lines", []):
            spans = [s for s in ln.get("spans", []) if s.get("text", "").strip()]
            if not spans:
                continue
            txt = norm_ar_keep("".join(s["text"] for s in spans))
            x0, y0, x1, y1 = ln["bbox"]
            s0 = spans[0]
            out.append({"text": txt, "bbox": [x0 / W, y0 / H, x1 / W, y1 / H],
                        "rect": [x0, y0, x1, y1], "size": round(s0["size"], 1),
                        "color": "#%06x" % s0.get("color", 0), "bold": bool(s0.get("flags", 0) & 16)})
    doc.close()
    return {"spans": out, "w": W, "h": H}


def op_edittext(p):
    f = get_file(p["id"])
    doc = open_pdf(p["id"], p.get("password"))
    edits = p["edits"]  # [{page, rect:[x0,y0,x1,y1], text, size, color, bold}]
    by_page = {}
    for e in edits:
        by_page.setdefault(int(e["page"]), []).append(e)
    for pno, es in by_page.items():
        pg = doc[pno]
        for e in es:
            r = pymupdf.Rect(*e["rect"])
            pg.add_redact_annot(r, fill=(1, 1, 1))
        try:
            pg.apply_redactions(images=pymupdf.PDF_REDACT_IMAGE_NONE)
        except TypeError:
            pg.apply_redactions()
        for e in es:
            if not (e.get("text") or "").strip():
                continue
            r = pymupdf.Rect(*e["rect"])
            size = float(e.get("size", 12))
            r2 = pymupdf.Rect(r.x0 - 4, r.y0 - 3, r.x1 + 4 + max(0, len(e["text"]) * size * 0.1), r.y1 + 3)
            put_text(pg, r2, e["text"], size, hex_to_rgb01(e.get("color", "#000000")),
                     bool(e.get("bold")), False, e.get("align", "right"))
    out = new_path(os.path.splitext(f["name"])[0] + "_معدّل.pdf")
    finalize(doc, out)
    return {"id": register(out), "name": os.path.basename(out), "edits": len(edits)}


def op_addtext(p):
    f = get_file(p["id"])
    doc = open_pdf(p["id"], p.get("password"))
    n = len(doc)
    idx = parse_pages(p.get("range", ""), n)
    kind = p.get("kind", "free")      # free | pagenum | header | footer
    text = p.get("text", "")
    size = float(p.get("size", 18))
    color = hex_to_rgb01(p.get("color", "#000000"))
    bold = bool(p.get("bold"))
    opacity = float(p.get("opacity", 1))
    angle = float(p.get("angle", 0) or 0)
    for k, i in enumerate(idx):
        pg = doc[i]
        W, H = pg.rect.width, pg.rect.height
        t = text
        if kind == "pagenum":
            num = i + 1
            if p.get("arabicDigits"):
                num = str(num).translate(str.maketrans("0123456789", "٠١٢٣٤٥٦٧٨٩"))
                tot = str(n).translate(str.maketrans("0123456789", "٠١٢٣٤٥٦٧٨٩"))
            else:
                tot = n
            t = (text or "{n}").replace("{n}", str(num)).replace("{total}", str(tot))
        w, h = text_size_estimate(t, size)
        if kind == "pagenum" or kind == "footer":
            pos = p.get("pos", "bottom-center")
        elif kind == "header":
            pos = p.get("pos", "top-center")
        else:
            pos = p.get("pos", "custom")
        m = 24
        if pos == "custom":
            x, y = float(p.get("x", .5)) * W - w / 2, float(p.get("y", .5)) * H - h / 2
        else:
            vert, horiz = pos.split("-")
            y = m if vert == "top" else (H - h - m if vert == "bottom" else (H - h) / 2)
            x = m if horiz == "left" else (W - w - m if horiz == "right" else (W - w) / 2)
        if angle and kind in ("free", "header", "footer"):
            png, (iw, ih) = render_text_png(t, size, color, bold, False, opacity, angle)
            sc = 72.0 / 300.0
            cx, cy = x + w / 2, y + h / 2
            rect = pymupdf.Rect(cx - iw * sc / 2, cy - ih * sc / 2, cx + iw * sc / 2, cy + ih * sc / 2)
            pg.insert_image(rect, stream=png, overlay=True)
        else:
            rect = pymupdf.Rect(x, y, x + w, y + h)
            put_text(pg, rect, t, size, color, bold, False, "center", opacity)
    out = new_path(os.path.splitext(f["name"])[0] + "_مع_نص.pdf")
    finalize(doc, out)
    return {"id": register(out), "name": os.path.basename(out), "pages": len(idx)}


OPS = {
    "watermark": op_watermark, "signature_clean": op_signature_clean, "sign": op_sign,
    "merge": op_merge, "split": op_split, "toimages": op_toimages,
    "edittext": op_edittext, "addtext": op_addtext,
}


# --------------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------------
class H(BaseHTTPRequestHandler):
    server_version = "PDFStudio/" + VERSION
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json; charset=utf-8", extra=None):
        if isinstance(body, (dict, list)):
            body = json.dumps(body, ensure_ascii=False).encode("utf8")
        elif isinstance(body, str):
            body = body.encode("utf8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _guard(self):
        host = (self.headers.get("Host") or "").split(":")[0]
        return host in ("127.0.0.1", "localhost")

    def do_GET(self):
        if not self._guard():
            return self._send(403, {"error": "forbidden"})
        u = urlparse(self.path)
        q = {k: v[0] for k, v in parse_qs(u.query).items()}
        try:
            if u.path in ("/", "/index.html"):
                return self._send(200, UI_HTML, "text/html; charset=utf-8")
            if u.path == "/api/ping":
                SEEN_PING[0] = True
                LAST_PING[0] = time.time()
                return self._send(200, {"ok": True, "name": APP_NAME, "version": VERSION,
                                        "credit": CREDIT_AR, "font": bool(FONT_PATH)})
            if u.path == "/api/info":
                return self._send(200, info_of(q["id"]))
            if u.path == "/api/thumb":
                doc = open_pdf(q["id"], q.get("password"))
                pg = doc[int(q.get("page", 0))]
                dpi = int(q.get("dpi", 70))
                data = pg.get_pixmap(dpi=dpi, alpha=False).tobytes("png")
                doc.close()
                return self._send(200, data, "image/png")
            if u.path == "/api/spans":
                return self._send(200, op_spans(q))
            if u.path.startswith("/dl/"):
                fid = u.path[4:].split("/")[0]
                f = get_file(fid)
                data = open(f["path"], "rb").read()
                ct = mimetypes.guess_type(f["name"])[0] or "application/octet-stream"
                fn = f["name"]
                from urllib.parse import quote
                return self._send(200, data, ct,
                                  {"Content-Disposition": "attachment; filename*=UTF-8''" + quote(fn)})
            return self._send(404, {"error": "not found"})
        except ApiError as e:
            return self._send(400, {"error": str(e)})
        except Exception as e:
            traceback.print_exc()
            return self._send(500, {"error": "خطأ غير متوقع: %s" % e})

    def do_POST(self):
        if not self._guard():
            return self._send(403, {"error": "forbidden"})
        u = urlparse(self.path)
        n = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(n) if n else b""
        try:
            if u.path == "/api/upload":
                q = {k: v[0] for k, v in parse_qs(u.query).items()}
                name = unquote(q.get("name", "file.pdf"))
                path = new_path(name)
                open(path, "wb").write(body)
                if not name.lower().endswith(".pdf") and body[:4] != b"%PDF":
                    pass
                fid = register(path, "pdf")
                try:
                    return self._send(200, info_of(fid))
                except Exception:
                    return self._send(400, {"error": "هذا الملف ليس PDF صالحًا"})
            if u.path.startswith("/api/op/"):
                op = u.path[8:]
                if op not in OPS:
                    return self._send(404, {"error": "unknown op"})
                p = json.loads(body.decode("utf8") or "{}")
                return self._send(200, OPS[op](p))
            if u.path == "/api/quit":
                self._send(200, {"ok": True})
                threading.Thread(target=lambda: (time.sleep(.3), os._exit(0)), daemon=True).start()
                return
            return self._send(404, {"error": "not found"})
        except ApiError as e:
            return self._send(400, {"error": str(e)})
        except Exception as e:
            traceback.print_exc()
            return self._send(500, {"error": "خطأ غير متوقع: %s" % e})


def free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    p = s.getsockname()[1]
    s.close()
    return p


def watchdog():
    """Quit shortly after the browser tab is closed."""
    t0 = time.time()
    while True:
        time.sleep(2)
        if SEEN_PING[0] and time.time() - LAST_PING[0] > 25:
            break
        if not SEEN_PING[0] and time.time() - t0 > 120:
            break
    shutil.rmtree(WORK, ignore_errors=True)
    os._exit(0)


def main():
    # pythonw.exe (Windows, no console) has no stdout/stderr
    if sys.stdout is None:
        sys.stdout = open(os.devnull, "w", encoding="utf8")
    if sys.stderr is None:
        sys.stderr = open(os.devnull, "w", encoding="utf8")
    port = int(os.environ.get("PDFSTUDIO_PORT", "0")) or free_port()
    srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    url = "http://127.0.0.1:%d/" % port
    print("%s — %s\n%s\n%s" % (APP_NAME, url, CREDIT_AR, CREDIT_EN))
    if "--no-browser" not in sys.argv:
        threading.Timer(0.6, lambda: webbrowser.open(url)).start()
    if "--keep" not in sys.argv:
        threading.Thread(target=watchdog, daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
PYEOF

# --- the double-clickable app: starts the local server and opens the browser
cat > "$APP_DIR/app.applescript" <<'ASEOF'
set pyBin to "__PY__"
set scriptPath to "__SCRIPT__"
set logPath to "__LOG__"
do shell script "export LANG=en_US.UTF-8 PYTHONIOENCODING=utf-8; nohup " & quoted form of pyBin & " " & quoted form of scriptPath & " >" & quoted form of logPath & " 2>&1 &"
ASEOF
sed -i '' -e "s#__PY__#$APP_DIR/venv/bin/python#" -e "s#__SCRIPT__#$APP_DIR/pdf_studio.py#" -e "s#__LOG__#$APP_DIR/log.txt#" "$APP_DIR/app.applescript"
rm -rf "$APP"
mkdir -p "$PREFIX/Applications"
osacompile -o "$APP" "$APP_DIR/app.applescript" || { alert "فشل إنشاء التطبيق / could not build the app"; exit 1; }

# desktop shortcut named "محرر PDF"
